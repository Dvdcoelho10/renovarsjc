# Configuração do servidor (nunca use o prefixo VITE_ nestas variáveis).
# Na Hostinger, cadastre as mesmas chaves nas variáveis de ambiente do app.
YOUTUBE_CHANNEL_ID=UCpnq0C4PXHGSIV2mjNAVrBw
YOUTUBE_API_KEY=cole_a_chave_da_youtube_data_api_v3
# Opcional: sobrescreve a playlist de uploads derivada do canal.
# YOUTUBE_UPLOADS_PLAYLIST_ID=UUpnq0C4PXHGSIV2mjNAVrBw

# MySQL (Hostinger / phpMyAdmin).
# Toda credencial de banco fica somente aqui ou nas variáveis da Hostinger,
# e é lida apenas por código de servidor. Nunca no frontend.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u000000000_banco
DB_USER=u000000000_usuario
DB_PASSWORD=
