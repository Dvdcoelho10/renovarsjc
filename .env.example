# Modelo das variáveis de ambiente do servidor.
# Copie para .env (local, fora do Git) e repita as mesmas chaves nas
# variáveis de ambiente do app na Hostinger.
# Nunca use o prefixo VITE_ nestas chaves: ele publica o valor no navegador.

# ---------------------------------------------------------------------------
# YouTube (rota /api/youtube/latest)
# ---------------------------------------------------------------------------
# Canal oficial: youtube.com/@TVRenovar — o channel ID começa com "UC".
YOUTUBE_CHANNEL_ID=
# Chave da YouTube Data API v3. Somente no servidor.
YOUTUBE_API_KEY=
# Opcional: sobrescreve a playlist de uploads derivada do canal.
# YOUTUBE_UPLOADS_PLAYLIST_ID=

# ---------------------------------------------------------------------------
# Formulário de contato (rota /api/contact, SMTP da Hostinger)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
# 465 usa TLS direto; 587 usa STARTTLS.
SMTP_PORT=465
SMTP_USER=contato@adrenovar.com.br
# Senha da caixa postal criada no hPanel > E-mails. Obrigatória para enviar.
SMTP_PASSWORD=
SMTP_FROM_NAME=Assembleia de Deus Renovar
CONTACT_TO_EMAIL=contato@adrenovar.com.br

# ---------------------------------------------------------------------------
# MySQL/MariaDB (painel administrativo e conteúdo compartilhado)
# ---------------------------------------------------------------------------
# Crie o banco no hPanel (Hostinger) e aplique
# database/migrations/001_admin_content_media.sql no phpMyAdmin.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Administrador inicial (usado apenas por scripts/create-admin.mjs)
# ---------------------------------------------------------------------------
# Defina na hora de rodar o script; não deixe a senha salva no .env.
# ADMIN_EMAIL=contato@adrenovar.com.br
# ADMIN_PASSWORD=
# ADMIN_RESET=0
